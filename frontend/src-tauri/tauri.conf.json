{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Atrin AI Control Plane",
  "version": "0.1.0",
  "identifier": "com.atrin.controlplane",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Atrin AI Control Plane",
        "width": 1280,
        "height": 860,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "minimizable": true,
        "closable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Atrin",
    "copyright": "Copyright © Atrin",
    "category": "Utility",
    "shortDescription": "Atrin AI Control Plane",
    "longDescription": "Atrin AI Control Plane provides durable workflow orchestration, provider adapters, and recovery management for end-to-end automation.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../atrin_core",
      "../pyproject.toml",
      "../README.md",
      "../scripts/ensure-python-runtime.ps1"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Atrin",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
