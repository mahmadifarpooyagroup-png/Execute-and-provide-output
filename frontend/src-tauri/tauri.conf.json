{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Atrin AI Control Plane",
  "version": "0.3.0",
  "identifier": "com.atrin.controlplane",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Atrin AI Control Plane",
        "width": 1280,
        "height": 860,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "minimizable": true,
        "closable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval' http://localhost:5173; connect-src 'self' http://127.0.0.1:8765 http://localhost:5173 ws://localhost:5173; img-src 'self' asset: https://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Atrin",
    "copyright": "Copyright (C) Atrin",
    "category": "Utility",
    "shortDescription": "Atrin AI Control Plane",
    "longDescription": "Atrin AI Control Plane provides durable workflow orchestration, provider adapters, and recovery management for end-to-end automation.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../../atrin_core",
      "../../pyproject.toml"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Atrin",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
